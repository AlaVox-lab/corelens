# SPDX-License-Identifier: MIT
# Copyright (c) 2026 AlaVox-lab
#
# Biến môi trường mẫu cho môi trường phát triển.
#
#     cp .env.example .env
#     docker compose --env-file .env up
#
# Mọi giá trị dưới đây CHẠY ĐƯỢC NGAY, không cần sửa gì để dựng thử.
# Nhưng chúng là mật khẩu mẫu công khai — BẮT BUỘC đổi trước khi triển khai thật.
# Tệp .env thật không bao giờ được commit lên kho mã.

# =============================================================================
# PostgreSQL — một thực thể, ba database
# =============================================================================
POSTGRES_PORT=5432

# Database nghiệp vụ, cũng là chủ sở hữu của thực thể
DXLAB_DB_NAME=dxlab
DXLAB_DB_USER=dxlab
DXLAB_DB_PASSWORD=doi_mat_khau_nay_truoc_khi_trien_khai

# Hai database còn lại, tạo bởi kịch bản trong postgres/init/
KEYCLOAK_DB_NAME=keycloak
SUPERSET_DB_NAME=superset

# Tài khoản chỉ đọc cấp cho Superset trên database nghiệp vụ.
# Bảng điều khiển phân tích không bao giờ ghi dữ liệu — xem ADR-0003.
SUPERSET_READONLY_USER=superset_readonly
SUPERSET_READONLY_PASSWORD=doi_mat_khau_nay_truoc_khi_trien_khai

# =============================================================================
# Keycloak — định danh tập trung (ADR-0001)
# =============================================================================
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak là dịch vụ nặng nhất cụm. Giảm giá trị này nếu máy ít RAM,
# nhưng dưới 512m thì khởi động chậm hẳn.
KEYCLOAK_MAX_HEAP=768m

# =============================================================================
# SeaweedFS — lưu trữ tệp đính kèm (ADR-0002)
# =============================================================================
SEAWEEDFS_S3_PORT=8333

# Kích thước tối đa một khối lưu trữ. Ảnh hưởng giới hạn tệp tải lên —
# xem issue #39 về việc đo giới hạn thật.
SEAWEEDFS_VOLUME_LIMIT_MB=512

# Khóa truy cập S3. Phải khớp với infra/seaweedfs/s3-config.json.
SEAWEEDFS_ACCESS_KEY=dxlab_access_key
SEAWEEDFS_SECRET_KEY=doi_mat_khau_nay_truoc_khi_trien_khai

# Tên thùng chứa tệp đính kèm. Dịch vụ ứng dụng tự tạo khi tải tệp đầu tiên lên, nên khóa trong
# infra/seaweedfs/s3-config.json được cấp riêng quyền Admin cho đúng thùng này (Admin:<tên
# thùng>) — đổi tên thùng ở đây thì phải đổi cả ở tệp đó, không thì SeaweedFS từ chối tạo thùng.
SEAWEEDFS_BUCKET=dxlab-attachments

# Giới hạn tệp đính kèm (#80). Đổi ở đây là đổi cho cả dịch vụ lẫn giao diện — giao diện hỏi
# dịch vụ nên hai lớp chặn không lệch nhau. Không cần down -v, chỉ khởi động lại dịch vụ.
# Đuôi tệp cho phép, cách nhau bằng dấu phẩy, không kèm dấu chấm. Cố ý không có zip, exe, bat,
# js, sh: tệp chạy được hay giấu được tệp chạy được.
ATTACHMENT_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,doc,docx,xls,xlsx,txt,csv
# Dung lượng tối đa mỗi tệp, tính bằng MB. Tệp đi qua dịch vụ ứng dụng nên đừng đặt quá lớn.
ATTACHMENT_MAX_MB=10
# Số tệp tối đa mỗi lần tải lên, và tổng số tệp tối đa của một hồ sơ
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_FILES_PER_CASE=20
# Mỗi đuôi phải trông thế nào (chữ ký đầu tệp, cách dò macro) nằm trong dữ liệu
# infra/seed/04-loai-tep-dinh-kem.sql (#248). Tệp có macro vẫn được nhận nhưng giao diện cảnh báo
# "có macro — cẩn thận khi mở"; muốn nhận .docm/.xlsm/.pptm thì thêm đuôi vào danh sách trên.

# Quét mã độc tệp đính kèm (#248) — TÙY CHỌN. Bật:
#     đặt CLAMAV_HOST=quet-tep dưới đây
#     docker compose --env-file .env --profile quet-tep up -d
# Rỗng là tắt — tệp chỉ được kiểm đuôi, chữ ký, macro. ClamAV tốn khoảng 1 GB bộ nhớ.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Hạn chót một lần quét, tính bằng giây
CLAMAV_TIMEOUT_SECONDS=15
# Quét bật mà dịch vụ quét không phản hồi: accept — nhận tệp, gắn cờ "chưa quét", ghi nhật ký;
# reject — từ chối lần tải (người gửi thử lại sau). Tệp bị báo có mã độc thì luôn bị từ chối.
CLAMAV_ON_UNAVAILABLE=accept
# true: không tự cập nhật mẫu nhận diện (dùng bộ mẫu kèm sẵn trong ảnh, chạy được khi không có mạng)
CLAMAV_NO_FRESHCLAMD=false

# =============================================================================
# Thông báo thư điện tử (#251) — TÙY CHỌN
# =============================================================================
# Rỗng là tắt: không sự kiện nào được xếp hàng, không thư nào được gửi, hệ thống chạy như cũ.
# Loại thông báo và lời thư nằm trong dữ liệu infra/seed/05-loai-thong-bao.sql; người dùng bật/tắt
# từng loại ở trang Thông báo của cổng. Địa chỉ thư lấy từ danh bạ Keycloak lúc gửi.
# Trình diễn với hộp thư thử Mailpit:
#     đặt SMTP_HOST=thu-thu và SMTP_PORT=1025 dưới đây
#     docker compose --env-file .env --profile thu-thu up -d
#     xem thư ở http://localhost:8025
# Máy chủ thư thật: điền máy chủ, cổng, tài khoản; SMTP_SECURITY là none, starttls (587) hay ssl (465).
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=none
SMTP_FROM=DX-OS Lab <khong-tra-loi@dx-os-lab.test>
# Nhịp bộ gửi (giây); số lần thử tối đa một thư; giây chờ trước lần thử lại đầu (nhân đôi mỗi lần)
NOTIFY_SCAN_INTERVAL_SECONDS=30
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_AFTER_SECONDS=60
# Bộ gửi nhớ danh bạ Keycloak (người, vai trò, phòng ban, địa chỉ thư) chừng này giây
NOTIFY_DIRECTORY_CACHE_SECONDS=120
# Cổng giao diện web của Mailpit trên máy, và số thư nó giữ
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# =============================================================================
# Apache Superset — bảng điều khiển phân tích (ADR-0003)
# =============================================================================
SUPERSET_PORT=8088
SUPERSET_VERSION=6.1.0
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# Khóa ký phiên làm việc. BẮT BUỘC thay bằng chuỗi ngẫu nhiên trước khi
# triển khai thật, sinh bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=khoa_mau_chi_dung_cho_phat_trien_doi_truoc_khi_trien_khai

# =============================================================================
# Dịch vụ ứng dụng và cổng người dùng
# =============================================================================

# Dùng làm thẻ cho hai ảnh chứa do nhóm tự dựng. Giữ khớp với phiên bản đang
# phát triển để biết ảnh trên máy thuộc đợt nào.
DXLAB_VERSION=0.3.0

# Dịch vụ ứng dụng — FastAPI. Tài liệu API tự sinh ở /docs
BACKEND_PORT=8000

# Cổng người dùng — Next.js
FRONTEND_PORT=3000

# =============================================================================
# Định danh tập trung — tham số dùng chung cho Keycloak, dịch vụ và cổng
# =============================================================================
KEYCLOAK_REALM=dx-os-lab

# Client của cổng người dùng. Đã đổi thành client BÍ MẬT ở #43: luồng OIDC chạy
# phía máy chủ Next.js nên bí mật không bao giờ tới trình duyệt.
KEYCLOAK_PORTAL_CLIENT_ID=dx-portal
KEYCLOAK_PORTAL_SECRET=doi_bi_mat_nay_truoc_khi_trien_khai

# Client của dịch vụ ứng dụng. Token phải mang tên này trong claim `aud`.
KEYCLOAK_API_CLIENT_ID=dx-api

# Tài khoản dịch vụ của danh bạ (#84): dịch vụ ứng dụng dùng nó để tra tên người
# trong một phòng ban. Chỉ mang quyền chỉ đọc view-users, không quản trị được gì.
# Bí mật phải khớp với client dx-directory trong infra/keycloak/realm-dx-os-lab.json.
KEYCLOAK_DIRECTORY_CLIENT_ID=dx-directory
KEYCLOAK_DIRECTORY_SECRET=doi_bi_mat_nay_truoc_khi_trien_khai

# Tiền tố đường dẫn group chứa phòng ban. Doanh nghiệp triển khai tổ chức cây
# group khác thì đổi ở đây, không sửa mã nguồn.
KEYCLOAK_DEPARTMENT_GROUP_PREFIX=/phong-ban/

# Khóa mã hóa cookie phiên của cổng người dùng. BẮT BUỘC thay bằng chuỗi ngẫu
# nhiên trước khi triển khai thật, sinh bằng: openssl rand -base64 32
PORTAL_SESSION_SECRET=khoa_mau_chi_dung_cho_phat_trien_doi_truoc_khi_trien_khai

# =============================================================================
# Nhật ký dịch vụ ứng dụng (#247)
# =============================================================================
# json: mỗi dòng một đối tượng JSON mang `request_id` — cổng gửi mã này theo mỗi lần gọi, lọc được
# một lượt thao tác bằng `docker compose logs backend | jq 'select(.request_id=="…")'`.
# text: dạng chữ, khi đọc tay.
LOG_FORMAT=json
LOG_LEVEL=INFO

# =============================================================================
# Theo dõi SLA
# =============================================================================
# Ngưỡng SLA của từng loại yêu cầu nằm trong bảng `request_types`, và trạng thái
# nào làm đồng hồ chạy nằm ở cột `states.sla_running` — cả hai đều là dữ liệu,
# sửa trong infra/seed/. Hai biến dưới đây chỉ là tham số vận hành.
SLA_SCAN_ENABLED=true

# Sáu mươi giây đủ mịn cho ngưỡng tính bằng giờ. Hạ xuống 5 khi cần trình diễn.
SLA_SCAN_INTERVAL_SECONDS=60

# Chạy nhiều bản dịch vụ ứng dụng thì mỗi lượt chỉ một bản quét (khóa tư vấn của PostgreSQL), bản
# kia bỏ lượt. Mỗi lượt ghi nhịp vào cơ sở dữ liệu; /health báo `degraded` khi bộ quét im quá lâu
# hoặc hỏng liên tiếp, màn Hệ thống hiện chi tiết (#253). Hai biến dưới đây là ngưỡng đó, và có
# mặc định trong docker-compose.yml nên tệp .env cũ không cần thêm.
#
# Quá bao nhiêu giây không có lượt quét thành công thì coi là quá lâu. 0 là tự tính: năm lần chu
# kỳ quét. Đặt nhỏ hơn hai chu kỳ thì bộ quét khỏe cũng bị báo quá lâu.
SLA_SCAN_STALE_AFTER_SECONDS=0
# Số lượt quét hỏng liên tiếp tới mức coi là đang hỏng
SLA_SCAN_MAX_CONSECUTIVE_ERRORS=3

# =============================================================================
# Giới hạn tốc độ (#243)
# =============================================================================
# Số lần tối đa mỗi người dùng trong một cửa sổ thời gian cố định, tính bằng giây. Vượt thì dịch vụ
# trả 429 kèm Retry-After và một câu tiếng Việt cho người dùng. Đặt số lần tối đa bằng 0 để tắt giới
# hạn đó. Bộ đếm nằm trong PostgreSQL nên đúng khi chạy nhiều bản dịch vụ. Cả sáu biến có mặc định
# trong docker-compose.yml, nên tệp .env cũ không cần thêm.
#
# Mặc định đủ rộng để người dùng thật không chạm tới; chỉ chặn vòng lặp kẹt hoặc lạm dụng.
RATE_LIMIT_CREATE_CASE_MAX=30
RATE_LIMIT_CREATE_CASE_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_MESSAGE_MAX=60
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=60

# Đăng nhập quay về (/api/auth/callback) giới hạn theo địa chỉ IP ngay ở cổng người dùng. Bộ đếm này
# nằm trong BỘ NHỚ của tiến trình cổng, vì cổng không chạm cơ sở dữ liệu: chạy nhiều bản cổng thì
# mỗi bản đếm riêng. Địa chỉ IP lấy từ header X-Forwarded-For, nên chỉ có nghĩa khi cổng đứng sau
# một reverse proxy đặt header đó; không có header thì mọi người dùng chung một bộ đếm.
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# =============================================================================
# Khai phá quy trình — không gian I (#314, ADR-0007)
# =============================================================================
# Tài khoản cơ sở dữ liệu CHỈ ĐỌC riêng của dịch vụ khai phá, tạo bằng migration lúc dịch vụ ứng dụng
# khởi động (không cần down -v). Đổi mật khẩu sau khi đã dựng cụm: ALTER ROLE bằng tay rồi đổi ở đây.
MINING_READONLY_USER=khai_pha_readonly
MINING_READONLY_PASSWORD=doi_mat_khau_nay_truoc_khi_trien_khai

# pm4py (mặc định) hay noi_bo — bộ máy dự phòng không dùng thư viện AGPL, cho cùng kết quả.
MINING_ENGINE=pm4py

# Trạng thái là điểm nghẽn khi thời gian chờ trung vị ở đó gấp từ chừng này lần trung vị chung.
MINING_BOTTLENECK_FACTOR=2

# Địa chỉ mã nguồn của dịch vụ khai phá (AGPL-3.0-or-later, điều 13 — #340): màn Quy trình thực tế
# dẫn tới đây. Bản tự triển khai có sửa dịch vụ khai phá thì trỏ về kho chứa bản đã sửa.
MINING_SOURCE_URL=https://github.com/AlaVox-lab/dx-os-lab/tree/main/services/khai-pha

# Cả năm biến có mặc định trong docker-compose.yml, nên tệp .env cũ không cần thêm.

# =============================================================================
# Mô hình ngôn ngữ — không gian I, TÙY CHỌN (#316, #317, ADR-0008)
# =============================================================================
# Mặc định TẮT: cụm không có dịch vụ mô hình, không gợi ý nào được sinh, điều phối chạy thủ công.
# Bật (cần thêm khoảng 1,5 GB bộ nhớ cho dịch vụ mô hình):
#     python scripts/tai_mo_hinh.py                      # tải tệp mô hình vào volume, kiểm SHA-256
#     đặt LLM_URL=http://mo-hinh:8080 dưới đây
#     docker compose --env-file .env --profile tri-tue up -d
# Tắt lại: để LLM_URL rỗng rồi `docker compose --env-file .env up -d` (dịch vụ mô hình dừng riêng bằng
# `docker compose --profile tri-tue stop mo-hinh`). `down -v` xóa cả tệp mô hình — phải tải lại.
LLM_URL=

# Hạn chót của một lần hỏi mô hình (giây). Gợi ý sinh ở nền nên hạn rộng; quá hạn là "không có gợi ý".
LLM_TIMEOUT_SECONDS=30

# Ngữ cảnh và số luồng CPU của dịch vụ mô hình
LLM_CONTEXT_SIZE=4096
LLM_THREADS=4

# Bộ quét bù gợi ý: nhịp quét, số lần thử tối đa cho một hồ sơ, khoảng cách tối thiểu giữa hai lần thử
SUGGEST_SCAN_INTERVAL_SECONDS=30
SUGGEST_MAX_ATTEMPTS=3
SUGGEST_RETRY_AFTER_SECONDS=600

# Gợi ý PHÒNG BAN của mô hình chỉ thay gợi ý theo bảng ánh xạ khi bật cờ này. Chỉ bật khi
# scripts/do_chinh_xac_goi_y.py đo trên bộ mẫu có nhãn đạt từ 80 % và hơn bảng ánh xạ.
SUGGEST_DEPARTMENT_FROM_MODEL=false

# Hồ sơ đã giải quyết tương tự trên biểu mẫu Gửi yêu cầu (#319): dịch vụ mô hình nhúng `mo-hinh-nhung`,
# cùng hồ sơ `tri-tue` (thêm khoảng 1 GB bộ nhớ). Rỗng là tắt — biểu mẫu như cũ.
EMBEDDING_URL=
EMBEDDING_CONTEXT_SIZE=8192
# Hạn chót một lần tìm khi người gửi đang gõ (giây) — quá hạn thì không hiện gợi ý nào
SIMILAR_TIMEOUT_SECONDS=2
SIMILAR_MAX_RESULTS=3
# Độ tương đồng cosine tối thiểu để một hồ sơ được hiện
SIMILAR_MIN_SCORE=0.55
# Xem gợi ý mà quá chừng này phút không gửi hồ sơ thì tính là một yêu cầu được ngăn chặn
SIMILAR_ABANDON_AFTER_MINUTES=30

# Khuyến nghị cải tiến trên màn Quy trình thực tế (#320) — dùng chính mô hình sinh văn bản ở trên
# (LLM_URL). Sinh ở nền, màn không chờ; mọi câu có con số không tra được trong kết quả khai phá bị bỏ.
RECOMMENDATION_ENABLED=true
# Hạn chót một lần sinh (giây) và số câu tối đa
RECOMMENDATION_TIMEOUT_SECONDS=90
RECOMMENDATION_MAX_SENTENCES=4

# Mọi biến mô hình ngôn ngữ đều có mặc định trong docker-compose.yml, tệp .env cũ không cần thêm.

# =============================================================================
# Gợi ý người xử lý cho trưởng phòng (#318) — KHÔNG cần mô hình ngôn ngữ
# =============================================================================
# Điểm của mỗi người nhận được việc trong phòng:
#     trọng số kinh nghiệm × ln(1 + số hồ sơ cùng loại đã làm xong) − trọng số tải × số việc đang giữ
# Người điểm cao nhất được gợi ý trên ô chọn người xử lý. Kinh nghiệm chỉ đếm trong số ngày gần nhất.
# Cả bốn biến có mặc định trong docker-compose.yml, tệp .env cũ không cần thêm.
ASSIGNEE_SUGGEST_ENABLED=true
ASSIGNEE_SUGGEST_LOAD_WEIGHT=1.0
ASSIGNEE_SUGGEST_EXPERIENCE_WEIGHT=1.0
ASSIGNEE_SUGGEST_HISTORY_DAYS=365

# --- Ủy quyền khi vắng mặt (#252) ---
# Một lần ủy quyền dài tối đa chừng này ngày
DELEGATION_MAX_DAYS=60

# =============================================================================
# Kho tri thức — Wiki.js, hồ sơ tùy chọn `tri-thuc` (#321, ADR-0006)
# =============================================================================
# Bật: docker compose --env-file .env --profile tri-thuc up -d
# Cổng web của kho tri thức trên máy
WIKI_PORT=3100
# Nối kho tri thức vào cổng (lối vào trên thanh bên, gợi ý bài khi soạn yêu cầu). Rỗng là TẮT.
# Bật hồ sơ `tri-thuc` thì đặt bằng địa chỉ trình duyệt mở wiki, ví dụ WIKI_URL=http://localhost:3100.
# Gợi ý bài cần thêm mô hình nhúng (EMBEDDING_URL, hồ sơ `tri-tue`)
WIKI_URL=
# Nhịp bộ lập chỉ mục bài viết (giây)
WIKI_INDEX_INTERVAL_SECONDS=120
# Database riêng của Wiki.js trên PostgreSQL của cụm (bước khởi tạo tự tạo)
WIKI_DB_NAME=wiki
# Client OIDC của kho tri thức trong Keycloak — bước khởi tạo tự tạo hoặc cập nhật
WIKI_OIDC_CLIENT_ID=dx-wiki
WIKI_OIDC_SECRET=doi_bi_mat_nay_truoc_khi_trien_khai
# Vai trò realm được đọc / được viết bài trên kho tri thức (mỗi vai một nhóm Wiki.js cùng tên)
WIKI_READ_ROLES=requester,classifier,approver,handler,administrator
WIKI_WRITE_ROLES=classifier,approver,administrator
# Tài khoản quản trị riêng của Wiki.js (đăng nhập cục bộ, không qua Keycloak). BẮT BUỘC đổi mật khẩu
WIKI_ADMIN_EMAIL=quan-tri-wiki@dx-os-lab.test
WIKI_ADMIN_PASSWORD=doi_mat_khau_nay_truoc_khi_trien_khai
# Ngôn ngữ giao diện — tải gói ngôn ngữ cần mạng ra ngoài; không tải được thì giữ tiếng Anh
WIKI_LOCALE=vi
