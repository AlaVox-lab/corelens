# Copyright (c) 2026 AlaVox-lab
#
# Biến môi trường mẫu cho môi trường phát triển.
#
#     cp .env.example .env
#     docker compose --env-file .env up
#
# Mọi giá trị dưới đây CHẠY ĐƯỢC NGAY, không cần sửa gì để dựng thử.
# Nhưng chúng là mật khẩu mẫu công khai — BẮT BUỘC đổi trước khi triển khai thật.
# Tệp .env thật không bao giờ được commit lên kho mã.

# =============================================================================
# PostgreSQL — một thực thể, ba database
# =============================================================================
POSTGRES_PORT=5432

# Database nghiệp vụ, cũng là chủ sở hữu của thực thể
DXLAB_DB_NAME=dxlab
DXLAB_DB_USER=dxlab
DXLAB_DB_PASSWORD=doi_mat_khau_nay_truoc_khi_trien_khai

# Hai database còn lại, tạo bởi kịch bản trong postgres/init/
KEYCLOAK_DB_NAME=keycloak
SUPERSET_DB_NAME=superset

# Tài khoản chỉ đọc cấp cho Superset trên database nghiệp vụ.
# Bảng điều khiển phân tích không bao giờ ghi dữ liệu — xem ADR-0003.
SUPERSET_READONLY_USER=superset_readonly
SUPERSET_READONLY_PASSWORD=doi_mat_khau_nay_truoc_khi_trien_khai

# =============================================================================
# Keycloak — định danh tập trung (ADR-0001)
# =============================================================================
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak là dịch vụ nặng nhất cụm. Giảm giá trị này nếu máy ít RAM,
# nhưng dưới 512m thì khởi động chậm hẳn.
KEYCLOAK_MAX_HEAP=768m

# =============================================================================
# SeaweedFS — lưu trữ tệp đính kèm (ADR-0002)
# =============================================================================
SEAWEEDFS_S3_PORT=8333

# Kích thước tối đa một khối lưu trữ. Ảnh hưởng giới hạn tệp tải lên —
# xem issue #39 về việc đo giới hạn thật.
SEAWEEDFS_VOLUME_LIMIT_MB=512

# Khóa truy cập S3. Phải khớp với infra/seaweedfs/s3-config.json.
SEAWEEDFS_ACCESS_KEY=dxlab_access_key
SEAWEEDFS_SECRET_KEY=doi_mat_khau_nay_truoc_khi_trien_khai

# =============================================================================
# Apache Superset — bảng điều khiển phân tích (ADR-0003)
# =============================================================================
SUPERSET_PORT=8088
SUPERSET_VERSION=6.1.0
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# Khóa ký phiên làm việc. BẮT BUỘC thay bằng chuỗi ngẫu nhiên trước khi
# triển khai thật, sinh bằng: openssl rand -base64 42
SUPERSET_SECRET_KEY=khoa_mau_chi_dung_cho_phat_trien_doi_truoc_khi_trien_khai

# =============================================================================
# Dịch vụ ứng dụng và cổng người dùng
# =============================================================================

# Dùng làm thẻ cho hai ảnh chứa do nhóm tự dựng. Giữ khớp với phiên bản đang
# phát triển để biết ảnh trên máy thuộc đợt nào.
DXLAB_VERSION=0.3.0

# Dịch vụ ứng dụng — FastAPI. Tài liệu API tự sinh ở /docs
BACKEND_PORT=8000

# Cổng người dùng — Next.js
FRONTEND_PORT=3000
