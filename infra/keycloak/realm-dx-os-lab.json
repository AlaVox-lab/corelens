{
  "realm": "dx-os-lab",
  "enabled": true,
  "displayName": "DX-OS Lab — Cổng vận hành yêu cầu nội bộ",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "requester",
        "description": "Người tạo yêu cầu — gửi yêu cầu và theo dõi hồ sơ của mình"
      },
      {
        "name": "classifier",
        "description": "Người phân loại yêu cầu — đọc nội dung, phân loại và chuyển về phòng ban phụ trách"
      },
      {
        "name": "handler",
        "description": "Người xử lý yêu cầu — thực hiện công việc và ghi nhận kết quả"
      },
      {
        "name": "approver",
        "description": "Người xét duyệt yêu cầu — xác duyệt định tuyến và phê duyệt khi phát sinh chi phí"
      },
      {
        "name": "administrator",
        "description": "Quản trị viên — quản lý phòng ban, loại yêu cầu, ngưỡng SLA và người dùng"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dx-portal",
      "name": "Cổng người dùng (Next.js)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "secret": "doi_bi_mat_nay_truoc_khi_trien_khai",
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-dx-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dx-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "dx-api",
      "name": "Dịch vụ ứng dụng (FastAPI)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "doi_bi_mat_nay_truoc_khi_trien_khai",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
